# BeyondGravity Supabase project (Dashboard → Project Settings → API)
# Copy to .env.local for local dev, and add the same two variables in Vercel → Settings → Environment Variables.
# The anon key is public by design; the race_leaderboard table is protected by RLS (see supabase/leaderboard.sql).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY
